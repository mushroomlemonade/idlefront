+}
+
+.pw-world-options .pw-choice-card {
+  text-align: left;
+  min-height: 0;
+  padding: 0.7rem 0.85rem;
+}
+
+.pw-world-options .pw-mode-summary {
+  margin-top: 0.35rem;
+}
+
+.pw-world-card .pw-mode-summary__label {
+  /* Keep concise labels accessible without overflowing small list cards. */
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+}
+
+@media (max-width: 600px) {
+  .pw-hub__actions {
+    width: 100%;
+  }
+  .pw-hub__actions .pw-button__medallion {
