/000000//////......------,,,,,,++++++******))))))((((((''''''&&&&&&%%%%%%$$$$$$######""""""!!!!!!!!!!!!!!!!!!````````````ММММММЊЊЊММММММЊЊЊ•••ХХХ`````````ХХХОООЌЌЌЌЌЌЌЌЌ••••••ЋЋЋ•••ќќќќќќ••••••ЏЏЏЏЏЏЏЏЏЏЏЏЋЋЋЋЋЋЏЏЏ••••••••••••••••••ЌЌЌЋЋЋЋЋЋЌЌЌЌЌЌЌЌЌЊЊЊЊЊЊЊЊЊЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЊЊЊЊЊЊЊЊЊЂЂЂЂЂЂЂЂЂЂЂЂЊЊЊ€€€ЊЊЊЊЊЊ€€€€€€ЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊ‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹€€€‡‡‡€€€‹‹‹‹‹‹‹‹‹‡‡‡‡‡‡††††††………†††††††††‡‡‡‡‡‡€€€‡‡‡‡‡‡‡‡‡†††………………………………………††††††‡‡‡‡‡‡‡‡‡††††††††††††††††††………………††††††‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡€€€€€€‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡€€€€€€‹‹‹‹‹‹€€€‡‡‡††††††††††††††††††††††††‡‡‡‡‡‡€€€‹‹‹‹‹‹‹‹‹€€€‡‡‡‡‡‡†††‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡€€€‹‹‹€€€‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹€€€‡‡‡€€€‹‹‹‹‹‹‹‹‹€€€€€€‹‹‹€€€‡‡‡‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹ЛЛЛЗЗЗЖЖЖЕЕЕГГГВВВГГГ```!!!!!!!!!!!!!!!!!!!!!```ЗЗЗ†††ЂЂЂЂЂЂЂЂЂЂЂЂЂЂЂЂЂЂ„„„„„„ѓѓѓЂЂЂЂЂЂЂЂЂѓѓѓ„„„………†††………………†††††††††………………………………………………„„„„„„………………………………†††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††‡‡‡††††††‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡†††††††111000000000000000//////000000//////......------,,,,,,++++++******))))))((((((''''''&&&&&&%%%%%%$$$$$$######""""""!!!!!!!!!!!!!!!!!!````````````ММММММЊЊЊММММММЊЊЊ•••ХХХ`````````ХХХОООЌЌЌЌЌЌЌЌЌ••••••ЋЋЋ•••ќќќќќќ••••••ЏЏЏЏЏЏЏЏЏЏЏЏЋЋЋЋЋЋЏЏЏ••••••••••••••••••ЌЌЌЋЋЋЋЋЋЌЌЌЌЌЌЌЌЌЊЊЊЊЊЊЊЊЊЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЌЊЊЊЊЊЊЊЊЊЂЂЂЂЂЂЂЂЂЂЂЂЊЊЊ€€€ЊЊЊЊЊЊ€€€€€€ЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊЊ‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹€€€‡‡‡€€€‹‹‹‹‹‹‹‹‹‡‡‡‡‡‡††††††………†††††††††‡‡‡‡‡‡€€€‡‡‡‡‡‡‡‡‡†††………………………………………††††††‡‡‡‡‡‡‡‡‡††††††††††††††††††………………††††††‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡€€€€€€‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡€€€€€€‹‹‹‹‹‹€€€‡‡‡††††††††††††††††††††††††‡‡‡‡‡‡€€€‹‹‹‹‹‹‹‹‹€€€‡‡‡‡‡‡†††‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡€€€‹‹‹€€€‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹€€€‡‡‡€€€‹‹‹‹‹‹‹‹‹€€€€€€‹‹‹€€€‡‡‡‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹ЛЛЛЗЗЗЖЖЖЕЕЕГГГВВВГГГ```!!!!!!!!!!!!!!!!!!!!!```ЗЗЗ†††ЂЂЂЂЂЂЂЂЂЂЂЂЂЂЂЂЂЂ„„„„„„ѓѓѓЂЂЂЂЂЂЂЂЂѓѓѓ„„„………†††………………†††††††††………………………………………………„„„„„„………………………………†††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††††‡‡‡††††††‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡‡