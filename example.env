# SSH Configuration
SSH_KEY=~/.ssh/your-ssh-key

# Docker Configuration
GHCR_USERNAME=username
GHCR_REPO=your-repo-name
GHCR_TOKEN=your_docker_token_here

DOMAIN=your-domain.com

# API Key
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Server Hosts
SERVER_HOST_STAGING=123.456.78.90
SERVER_HOST_NBG1=123.456.78.92

# Version
VERSION_TAG="latest"

# Private match telemetry (disabled by default)
TELEMETRY_ENABLED=false
TELEMETRY_INGEST_URL=
TELEMETRY_SIGNING_SECRET=
TELEMETRY_BATCH_SIZE=200
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_REQUEST_TIMEOUT_MS=5000
TELEMETRY_MAX_QUEUE_SIZE=20000
TELEMETRY_MAX_QUEUE_BYTES=33554432
TELEMETRY_MAX_EVENT_BYTES=1048576
TELEMETRY_PER_PLAYER_PER_TICK_CAP=32

# Standalone idle demo authority
# Keep this on durable local storage. The directory is created automatically.
IDLE_DB_PATH=.data/idle-demo.sqlite
# Full-server persistent worlds use namespaced tables in the same backed-up DB.
PERSISTENT_WORLD_DB_PATH=.data/idle-demo.sqlite
# The standalone preview authority is deliberately loopback-only.
IDLE_AUTHORITY_HOST=127.0.0.1
IDLE_AUTHORITY_PORT=3000
# Development-only aggregate watchdog endpoint. Leave false on a public origin.
IDLE_ADMIN_ENABLED=false
# Required whenever IDLE_ADMIN_ENABLED=true. Generate a long random secret.
IDLE_ADMIN_TOKEN=
# Explicit local-only opt-in. Never enable on a tunneled/public preview.
IDLE_DEBUG_ERRORS=false
# Keep outside the database; rotate between retention windows.
IDLE_TELEMETRY_HMAC_SECRET=
# Password-gated loopback gateway used as the only tunnel origin.
IDLE_PREVIEW_HOST=127.0.0.1
IDLE_PREVIEW_PORT=3100
IDLE_PREVIEW_ORIGIN=http://127.0.0.1:3000
IDLE_PREVIEW_ACCESS_TOKEN=
# Live raw receipts expire after 14 days; values above 14 are rejected.
IDLE_RAW_TAP_RETENTION_DAYS=14
# Production Docker sets one exact private bridge gateway; local dev leaves blank.
IDLE_TRUSTED_PROXY_ADDRESS=
