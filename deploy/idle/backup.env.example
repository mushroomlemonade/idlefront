# restic encrypts snapshots before they leave this VM.
RESTIC_REPOSITORY=s3:https://object-storage.example.com/openfront-idle-backups
RESTIC_PASSWORD_FILE=/etc/openfront-idle/restic-password

# Provider-specific credentials belong only in /etc/openfront-idle/backup.env.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

IDLE_DB_PATH=/var/lib/openfront-idle/idle.sqlite
# PERSISTENT_WORLD_DB_PATH intentionally points at this same mounted database
# in openfront-idle.env, so the verified snapshot above includes both stores.
IDLE_BACKUP_STAGING_DIR=/var/lib/openfront-idle/backup-staging
IDLE_BACKUP_HOST=openfront-idle-production
