# systemd reads IDLE_IMAGE; Docker passes the remaining values to the app.
# Replace this placeholder with the immutable digest emitted by idle-ci.yml.
IDLE_IMAGE_REPOSITORY=ghcr.io/owner/repository
IDLE_IMAGE=ghcr.io/owner/repository@sha256:replace_with_64_hex_characters

GAME_ENV=prod
NUM_WORKERS=1
DOMAIN=idle.example.com
CDN_BASE=
TURNSTILE_SITE_KEY=replace_before_player_auth_is_enabled
API_KEY=
ADMIN_BOT_API_KEY=

IDLE_DB_PATH=/var/lib/openfront-idle/idle.sqlite
# Persistent-world tables use a namespaced migration ledger in this same file,
# keeping deploy rollback and encrypted backups atomic across both services.
PERSISTENT_WORLD_DB_PATH=/var/lib/openfront-idle/idle.sqlite
# The app writes this machine-readable file after SIGUSR2 asks it to stop
# admitting non-resumable games. The deploy wrapper waits for it before stop.
IDLE_DEPLOY_DRAIN_STATUS_PATH=/var/lib/openfront-idle/deployment-drain.status
# Abort and reopen admission instead of cutting off a very long ordinary game.
IDLE_DEPLOY_DRAIN_TIMEOUT_SECONDS=7200
IDLE_ADMIN_ENABLED=false
IDLE_ADMIN_TOKEN=
IDLE_TELEMETRY_HMAC_SECRET=replace_with_at_least_32_random_characters
# Optional guest playtest credential key. If omitted, the telemetry key is
# reused; set a separate 32+ character value for production isolation.
IDLE_GUEST_PLAY_TOKEN_SECRET=replace_with_at_least_32_random_characters
IDLE_RAW_TAP_RETENTION_DAYS=14
# Must match the isolated Docker network gateway created in the runbook.
IDLE_TRUSTED_PROXY_ADDRESS=172.30.0.1
